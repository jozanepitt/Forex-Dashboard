# Copy this file to .env and fill in your real Twelve Data API keys.
# Get free keys at https://twelvedata.com — free plan: 800 credits/day/key.
# Add as many KEY_N / KEY_N_NAME pairs as you have keys (stops at first gap).

TWELVEDATA_KEY_1_NAME=my_key_1
TWELVEDATA_KEY_1=your_twelvedata_api_key_here

TWELVEDATA_KEY_2_NAME=my_key_2
TWELVEDATA_KEY_2=your_second_api_key_here

# TWELVEDATA_KEY_3_NAME=my_key_3
# TWELVEDATA_KEY_3=your_third_api_key_here

# TWELVEDATA_KEY_4_NAME=my_key_4
# TWELVEDATA_KEY_4=your_fourth_api_key_here

# Optional: Stooq CSV fallback (captcha-gated — see README)
# STOOQ_APIKEY=your_stooq_api_key_here

SERVICE_PORT=3002
SERVICE_HOST=127.0.0.1
DAILY_CREDIT_LIMIT=800
CREDIT_SAFETY_MARGIN=50

# --- Execution bot (python -m bot). Never put a real password in git. ---
# Leave BOT_STRATEGY empty until you have read BACKTEST_RESULTS.md.
# The bot refuses a real (non-demo) account unless BOTH live flags are true.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial
MT5_SYMBOL_SUFFIX=m
MT5_BOT_LIVE=false
MT5_BOT_CONFIRM_LIVE=false
BOT_STRATEGY=
BOT_TIMEFRAME=M15
BOT_ENTRY=close
BOT_SYMBOLS=EUR/USD
BOT_GRADES=alert
BOT_RISK_PCT=0.5
BOT_MAX_OPEN_POSITIONS=3
BOT_DAILY_LOSS_PCT=2
BOT_MAX_TRADES_PER_DAY=5
BOT_MAX_SPREAD_MULT=2
BOT_SESSION_FILTER=true
BOT_SESSION_START_UTC=7
BOT_SESSION_END_UTC=20
BOT_NEWS_FILTER=false
BOT_NEWS_WINDOW_MIN=30
BOT_KILL_SWITCH=false
BOT_KILL_CLOSE=false
BOT_MAGIC=2601801
BOT_DEVIATION_POINTS=30
BOT_POLL_SECONDS=20
